/*--------------------------------*- C++ -*----------------------------------*\
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system/fluid";
    object      fvSolution;
}
solvers
{
    "p_rgh.*"
    {
        solver          GAMG;
        smoother        symGaussSeidel;
        tolerance       1e-7;
        relTol          0.01;
    }
    "(U|h|k|omega).*"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-7;
        relTol          0.1;
    }
}
PIMPLE
{
    momentumPredictor           yes;
    nNonOrthogonalCorrectors    0;
    pRefCell                    0;
    pRefValue                   0;

    residualControl
    {
        p_rgh               1e-4;
        // Segregated momentum: "U" does not match Ux/Uy/Uz in the convergence check.
        "(Ux|Uy|Uz)"        1e-4;
        h                   1e-4;
        k                   1e-4;
        omega               1e-4;
    }
}
relaxationFactors
{
    fields
    {
        rho             1.0;
        p_rgh           0.3;
    }
    equations
    {
        U               0.3;
        h               0.3;
        k               0.3;
        omega           0.3;
    }
}
