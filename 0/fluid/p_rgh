        type            fixedFluxPressure;
        value           $internalField;
    }
    outlet
    {
        type            fixedValue;
        value           uniform 0;
    }
    wall-channel
    {
        type            fixedFluxPressure;
        value           $internalField;
    }
    fluid_to_solid
    {
        type            fixedFluxPressure;
        value           $internalField;
    }
}
