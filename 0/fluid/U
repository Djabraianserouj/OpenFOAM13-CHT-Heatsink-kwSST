/*--------------------------------*- C++ -*----------------------------------*\
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0/fluid";
    object      U;
}
dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (3.7 0 0); // ~3.7 m/s measured by hot wire anemometer at 115 mm before the heat sink 
boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"
    inlet
    {
        type            fixedValue;
        value           uniform (3.7 0 0);
    }
    outlet
    {
        type            pressureInletOutletVelocity;
        value           $internalField;
    }
    wall-channel
    {
        type            noSlip;
    }
    fluid_to_solid
    {
        type            noSlip;
    }
}
