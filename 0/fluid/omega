FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0/fluid";
    object      omega;
}
dimensions      [0 0 -1 0 0 0 0];
internalField   uniform 168.902;
boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"
    inlet
    {
        type            turbulentMixingLengthFrequencyInlet;
        mixingLength    0.003111;
        value           $internalField;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }
    fluid_to_solid
    {
        type            omegaWallFunction;
        value           $internalField;
    }
    wall-channel
    {
        type            omegaWallFunction;
        value           $internalField;
    }
}
